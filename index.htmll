
          কাজ সম্পন্ন
        </button>
      </div>

    </div>
  </section>

  <section class="section" id="withdraw">
    <h2>💳 উইথড্র আবেদন</h2>

    <form onsubmit="withdrawMoney(event)">

      <input
        type="text"
        id="name"
        placeholder="আপনার নাম"
        required
      >

      <input
        type="tel"
        id="number"
        placeholder="বিকাশ / নগদ নম্বর"
        required
      >

      <select id="method" required>
        <option value="">পেমেন্ট মাধ্যম নির্বাচন করুন</option>
        <option value="বিকাশ">বিকাশ</option>
        <option value="নগদ">নগদ</option>
      </select>

      <input
        type="number"
        id="withdrawAmount"
        placeholder="কত টাকা তুলবেন?"
        min="1"
        required
      >

      <div class="captcha-box">
        <div id="captcha"></div>
        <button
          type="button"
          class="refresh"
          onclick="generateCaptcha()"
        >
          ↻
        </button>
      </div>

      <input
        type="text"
        id="captchaInput"
        placeholder="উপরের কোডটি লিখুন"
        required
      >

      <button type="submit">
        উইথড্র আবেদন করুন
      </button>

    </form>
  </section>

  <section class="section" id="contact">
    <h2>📞 যোগাযোগ</h2>

    <div class="social-buttons">

      <a
        class="btn telegram"
        href="https://t.me/"
        target="_blank"
      >
        ✈️ Telegram
      </a>

      <a
        class="btn facebook"
        href="https://www.facebook.com/"
        target="_blank"
      >
        📘 Facebook
      </a>

      <a
        class="btn youtube"
        href="https://www.youtube.com/"
        target="_blank"
      >
        ▶️ YouTube
      </a>

    </div>
  </section>

</div>

<footer>
  <strong>Bangla Earn Hub</strong><br>
  © 2026 All Rights Reserved
</footer>

<script>

  let balance = Number(localStorage.getItem("balance")) || 0;

  document.getElementById("balance").innerText =
    balance.toFixed(2);

  function updateBalance() {
    document.getElementById("balance").innerText =
      balance.toFixed(2);

    localStorage.setItem("balance", balance);
  }

  function completeTask(amount, taskName) {

    balance += amount;

    updateBalance();

    alert(
      "✅ " +
      taskName +
      " কাজ সম্পন্ন হয়েছে!\n৳ " +
      amount +
      " ব্যালেন্সে যোগ হয়েছে।"
    );
  }

  let captchaCode = "";

  function generateCaptcha() {

    const chars =
      "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";

    captchaCode = "";

    for (let i = 0; i < 6; i++) {
      captchaCode +=
        chars.charAt(
          Math.floor(Math.random() * chars.length)
        );
    }

    document.getElementById("captcha").innerText =
      captchaCode;
  }

  function withdrawMoney(event) {

    event.preventDefault();

    const name =
      document.getElementById("name").value.trim();

    const number =
      document.getElementById("number").value.trim();

    const method =
      document.getElementById("method").value;

    const amount =
      Number(
        document.getElementById("withdrawAmount").value
      );

    const captchaInput =
      document.getElementById("captchaInput")
      .value
      .trim()
      .toUpperCase();

    if (captchaInput !== captchaCode) {

      alert("❌ CAPTCHA কোড সঠিক নয়।");

      generateCaptcha();

      return;
    }

    if (amount > balance) {

      alert(
        "❌ আপনার ব্যালেন্স যথেষ্ট নয়।\n" +
        "বর্তমান ব্যালেন্স: ৳ " +
        balance.toFixed(2)
      );

      return;
    }

    if (amount <= 0) {

      alert("❌ সঠিক পরিমাণ লিখুন।");

      return;
    }

    balance -= amount;

    updateBalance();

    alert(
      "✅ উইথড্র আবেদন গ্রহণ করা হয়েছে!\n\n" +
      "নাম: " + name + "\n" +
      "মাধ্যম: " + method + "\n" +
      "নম্বর: " + number + "\n" +
      "পরিমাণ: ৳ " + amount.toFixed(2) +
      "\n\nপ্রশাসক যাচাই করার পর পেমেন্ট করবেন।"
    );

    event.target.reset();

    generateCaptcha();
  }

  generateCaptcha();

</script>

</body>
</html>
